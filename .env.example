# Copy to .env and fill in. Real environment variables take precedence over .env.

# Google Gemini API key (https://aistudio.google.com/app/apikey). Without it the
# assistant answers with a fixed "please call the helpline" fallback message.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Faster-Whisper model size: tiny, base, small, medium, large-v3 (default).
# large-v3 needs a GPU for real-time latency; use small/medium on CPU.
WHISPER_MODEL=large-v3

# Redis (optional; falls back to in-memory sessions + data/sample_hospital.json)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Bearer token required for admin write endpoints. Leave empty only for local dev.
ADMIN_TOKEN=

# Comma-separated list of allowed CORS origins. Empty = same-origin only.
CORS_ORIGINS=

# Maximum upload size for /process in megabytes
MAX_UPLOAD_MB=10

# Directory containing Piper .onnx voices (default: ./piper_voices)
# PIPER_VOICE_DIR=

# Set to false to start the web/admin API without loading speech models
LOAD_MODELS=true

# Only needed for experiments/ notebooks and scripts that use gated HF models
# HF_TOKEN=
